# Supabase project URL and public anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Keep secrets out of NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay test/live values. Do not expose the secret in client code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public app URL, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
